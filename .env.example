# TraceMind 本地环境变量样例(复制为 .env.local 并填真实值)
# 注意:真实密码/Key 只存在于 .env.local / .env.vm / CI Secrets,绝不提交。

# LLM(fake / real_strict / real_demo)
TRACEMIND_LLM_MODE=fake
TRACEMIND_CHAT_BASE_URL=
TRACEMIND_CHAT_API_KEY=
TRACEMIND_CHAT_MODEL=
TRACEMIND_EVAL_CHAT_MODEL=

# Embedding(与 Chat 独立)
TRACEMIND_EMBEDDING_BASE_URL=
TRACEMIND_EMBEDDING_API_KEY=
TRACEMIND_EMBEDDING_MODEL=text-embedding-v4
TRACEMIND_EMBEDDING_DIMENSIONS=1024

# 数据库(本地默认值;CI 由 Job Env 注入,不用这些)
TRACEMIND_CONTROL_DB_URL=mysql+pymysql://tracemind_control_app:control_app_pwd@localhost:3306/tracemind_control
TRACEMIND_READONLY_DB_URL=mysql+pymysql://ai_investigator:investigator_pwd@localhost:3306/tracemind_business
TRACEMIND_SESSION_TERMINATOR_DB_URL=mysql+pymysql://session_terminator:terminator_pwd@localhost:3306/
TRACEMIND_FIX_EXECUTOR_DB_URL=mysql+pymysql://fix_executor:fix_executor_pwd@localhost:3306/tracemind_business

# 可观测性
TRACEMIND_METRICS_BACKEND=fixture
TRACEMIND_TRACE_BACKEND=fixture
TRACEMIND_PROMETHEUS_URL=http://localhost:9090
TRACEMIND_JAEGER_QUERY_ENDPOINT=localhost:16685
