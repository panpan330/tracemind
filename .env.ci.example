# TraceMind CI 变量样例(真实值存 GitHub Secrets / Job Env,不入库)
# 用途:Compose 静态校验、文档示例。CI 实际注入见 .github/workflows/*.yml。

# Run Profile(CI 数据库档)
TRACEMIND_RUN_PROFILE=ci_db
TRACEMIND_LLM_MODE=fake

# MySQL 版本常量(Fast/Full/VM 三处同步固定,不用浮动 tag)
TRACEMIND_MYSQL_IMAGE=mysql:8.0.39

# 数据库账号密码:由 CI Job Env / GitHub Secrets 注入,此处仅占位说明
# TRACEMIND_DB_CONTROL_APP_PASSWORD
# TRACEMIND_DB_APP_BUSINESS_PASSWORD
# TRACEMIND_DB_AI_INVESTIGATOR_PASSWORD
# TRACEMIND_DB_FIX_EXECUTOR_PASSWORD
# TRACEMIND_DB_SESSION_TERMINATOR_PASSWORD

# 真实模型(仅 Full e2e 用;Fast 不注入)
# TRACEMIND_CHAT_API_KEY
# TRACEMIND_CHAT_BASE_URL
# TRACEMIND_CHAT_MODEL
# TRACEMIND_EVAL_CHAT_MODEL
